# ---------------------------------------------------------------------------
# MCP server credentials for the Bid Management AI agents (.mcp.json)
#
# Copy to `.env` and fill in only the servers you actually enable.
# Never commit a real `.env` — it is git-ignored. `.env.example` is safe to commit.
#
# Each server is optional: if you do not set its credentials, just remove (or
# leave disabled) that entry in `.mcp.json`. Remote (http/sse) servers will
# prompt for OAuth in Claude Code where no token is shown below.
# ---------------------------------------------------------------------------

# --- Core / docs ---
GITHUB_MCP_PAT=            # GitHub PAT for the hosted GitHub MCP server
CONTEXT7_API_KEY=         # Optional; raises Context7 rate limits
HF_TOKEN=                 # Hugging Face access token
# deepwiki: no credentials required

# --- Vector DB / data ---
CHROMA_DATA_DIR=./.chroma         # Local persistent Chroma store
QDRANT_URL=                       # e.g. https://xyz.cloud.qdrant.io:6333
QDRANT_API_KEY=
PINECONE_API_KEY=
MEM0_API_KEY=
SUPABASE_ACCESS_TOKEN=            # Supabase personal access token
SUPABASE_PROJECT_REF=             # Supabase project ref (read-only mode)
DATABASE_URI=                     # postgresql://user:pass@host:5432/db (postgres-mcp)

# --- Observability / web ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
PHOENIX_BASE_URL=http://localhost:6006
PHOENIX_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
APIFY_TOKEN=
# sentry: OAuth via the hosted remote server (no token here)
ZAPIER_MCP_URL=                   # Your private Zapier MCP endpoint URL

# --- Sandboxes / browsers ---
E2B_API_KEY=
# playwright, chrome-devtools: no credentials required

# --- Reasoning / thinking ---
ANTHROPIC_API_KEY=                # Used by mas-sequential-thinking, cipher

# --- Memory / knowledge graph ---
MEMORY_FILE_PATH=./.memory/memory.json
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
LETTA_BASE_URL=http://localhost:8283
LETTA_API_KEY=

# --- Code / context ---
OPENAI_API_KEY=                   # Embeddings for claude-context, cognee, graphiti
MILVUS_TOKEN=                     # Zilliz Cloud / Milvus token for claude-context
# serena, repomix: no credentials required
